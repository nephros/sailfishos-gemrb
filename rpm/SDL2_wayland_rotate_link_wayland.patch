diff --git a/cmake/Helpers.cmake b/cmake/Helpers.cmake
index dff9712b2..dcf182d35 100644
--- a/cmake/Helpers.cmake
+++ b/cmake/Helpers.cmake
@@ -189,6 +189,10 @@ FUNCTION(CONFIGURE_SDL SDL_BACKEND)
 			SET(SDL2_LIBRARIES debug ${SDL2_LIBRARY_DEBUG} optimized ${SDL2_LIBRARY_RELEASE})
 		ELSE()
 			FIND_PACKAGE(SDL2 REQUIRED)
+			LIST(APPEND CMAKE_MODULE_PATH "/usr/share/ECM/cmake/")
+			FIND_PACKAGE(ECM REQUIRED NO_MODULE)
+			LIST(APPEND CMAKE_MODULE_PATH ${ECM_MODULE_PATH})
+			FIND_PACKAGE(Wayland REQUIRED COMPONENTS Client OPTIONAL_COMPONENTS Egl)
 		ENDIF()
 	ENDIF()
 
@@ -201,6 +205,10 @@ FUNCTION(CONFIGURE_SDL SDL_BACKEND)
 		UNSET(SDL_INCLUDE_DIR CACHE)
 		UNSET(SDL_LIBRARY CACHE)
 
+		IF(Wayland_Client_FOUND)
+			MESSAGE(STATUS "Found SDL 2.0, switching to SDL2 backend.")
+			SET_INTERNAL(WAYLAND_LIBRARY "${Wayland_LIBRARIES}")
+		ENDIF()
 		IF(SDL2_FOUND)
 			MESSAGE(STATUS "Found SDL 2.0, switching to SDL2 backend.")
 			SET_INTERNAL(SDL_FOUND ${SDL2_FOUND})
